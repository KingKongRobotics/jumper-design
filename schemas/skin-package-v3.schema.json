{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kingkong.tech/schemas/skin-package-v3.schema.json",
  "title": "Kingkong portable full-robot skin package",
  "description": "Display-only full-robot .skin manifest. Print assets are forbidden. Structural, source, and physics checks require shellflow.skin_package.validate.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "title",
    "version",
    "author",
    "license_id",
    "platform",
    "source",
    "collision_policy",
    "inertia_policy",
    "physical_fit_tested",
    "physical_dynamics_validated",
    "files",
    "visual_overrides"
  ],
  "properties": {
    "schema": {
      "const": "kk-skin-package/3"
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "version": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "author": {
      "type": "string"
    },
    "license_id": {
      "type": "string"
    },
    "platform": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "profile_sha256",
        "baseline_sha256",
        "mechanical_platform",
        "mechanical_interface_sha256",
        "parent_link",
        "visual_replacement",
        "cad_unit",
        "simulation_unit",
        "frame"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
        },
        "profile_sha256": {
          "$ref": "#/$defs/hash"
        },
        "baseline_sha256": {
          "$ref": "#/$defs/hash"
        },
        "mechanical_platform": {
          "const": "original-robot-v1"
        },
        "mechanical_interface_sha256": {
          "$ref": "#/$defs/hash"
        },
        "parent_link": {
          "type": "string",
          "minLength": 1
        },
        "visual_replacement": {
          "type": "object",
          "required": [
            "mode"
          ],
          "properties": {
            "mode": {
              "enum": [
                "dedicated_link",
                "split_base"
              ]
            }
          },
          "additionalProperties": {
            "type": "string"
          }
        },
        "cad_unit": {
          "const": "millimeter"
        },
        "simulation_unit": {
          "const": "meter"
        },
        "frame": {
          "const": "original-robot-v1 CAD Z-up"
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "shell_sha256",
        "report_sha256",
        "producer_code_sha256",
        "omitted_source_files"
      ],
      "properties": {
        "shell_sha256": {
          "$ref": "#/$defs/hash"
        },
        "report_sha256": {
          "$ref": "#/$defs/hash"
        },
        "producer_code_sha256": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/hash"
          }
        },
        "omitted_source_files": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "collision_policy": {
      "const": "baseline_preserved"
    },
    "inertia_policy": {
      "const": "baseline_preserved"
    },
    "physical_fit_tested": {
      "const": false
    },
    "physical_dynamics_validated": {
      "const": false
    },
    "files": {
      "type": "object",
      "minProperties": 7,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "bytes",
          "sha256"
        ],
        "properties": {
          "bytes": {
            "type": "integer",
            "minimum": 0
          },
          "sha256": {
            "$ref": "#/$defs/hash"
          }
        }
      }
    },
    "visual_overrides": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "link",
          "geom",
          "rgba"
        ],
        "properties": {
          "link": {
            "type": "string",
            "minLength": 1
          },
          "geom": {
            "type": "string",
            "minLength": 1
          },
          "rgba": {
            "type": "array",
            "minItems": 4,
            "maxItems": 4,
            "prefixItems": [
              {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              {
                "const": 1
              }
            ],
            "items": false
          }
        }
      }
    }
  },
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
