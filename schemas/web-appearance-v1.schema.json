{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BE Web appearance 1",
  "type": "object",
  "required": [
    "schema",
    "profile",
    "colorSpace",
    "materials",
    "lighting",
    "renderer"
  ],
  "properties": {
    "schema": {
      "const": "kk-web-appearance/1"
    },
    "profile": {
      "const": "be-web/1"
    },
    "colorSpace": {
      "const": "srgb"
    },
    "lighting": {
      "const": {
        "mode": "web-default",
        "builtInScale": 1
      }
    },
    "renderer": {
      "const": {
        "toneMapping": "aces-filmic",
        "exposure": 0.95,
        "outputColorSpace": "srgb",
        "background": "#eef1ed",
        "fog": {
          "near": 6,
          "far": 16,
          "color": "#eef1ed"
        }
      }
    },
    "materials": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": [
          "color",
          "opacity",
          "roughness",
          "metalness",
          "emissive",
          "emissiveIntensity",
          "unlit",
          "side",
          "flatShading"
        ],
        "properties": {
          "opacity": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "roughness": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "metalness": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "color": {
            "type": "string",
            "pattern": "^#[0-9a-fA-F]{6}$"
          },
          "emissive": {
            "type": "string",
            "pattern": "^#[0-9a-fA-F]{6}$"
          },
          "emissiveIntensity": {
            "type": "number",
            "minimum": 0
          },
          "unlit": {
            "type": "boolean"
          },
          "flatShading": {
            "type": "boolean"
          },
          "side": {
            "enum": [
              "front",
              "back",
              "double"
            ]
          }
        }
      }
    }
  }
}
