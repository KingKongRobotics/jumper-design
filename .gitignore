workspaces/
projects/
reference_workspace/
checks/
workbench/
outputs/
dist/
/build/
*.egg-info/
*.stl
*.step
*.STEP
*.stp
*.brep
*.npz
*.glb
*.gltf
*.ply
*.obj
*.fbx
*.blend
