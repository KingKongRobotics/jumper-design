# Only the curated current skin collection is versioned; build outputs stay local.
!library/skins/**/*.skin
!library/maps/**/*.map
!library/map-sources/**/assets/**
# Runtimes and editor state
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
/tmp*/
.coverage
.DS_Store
Thumbs.db
.idea/
.vscode/
# Curated deliveries and robot meshes use Git LFS.
!platforms/bundles/*.platform.zip
!library/assets/**/*.stl
!library/assets/**/*.3mf
!robots/**/meshes/*.stl
!robots/**/meshes/*.STL
!robots/**/meshes/**/*.stl
!robots/**/meshes/**/*.STL
!library/simulations/**/meshes/*.stl
!library/simulations/**/meshes/*.STL
